# Supabase PostgreSQL URI, including the database username and URL-encoded password.
# Use the session pooler URI if the direct host requires unavailable IPv6 connectivity.
DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional; defaults shown below.
# APP_FRONTEND_ORIGIN=http://localhost:3000
# VITE_API_URL=http://localhost:8080
# Optional: use validate for a database whose schema is managed separately.
# DB_DDL_AUTO=update
